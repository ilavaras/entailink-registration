<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Onboarding" targetNamespace="https://entailink.com/onboarding"><bpmn:process id="entailink_customer_onboarding" name="EntaiLink customer onboarding" isExecutable="true"><bpmn:startEvent id="Start" name="Registration received" /><bpmn:userTask id="Review" name="Review organisation and administrator"><bpmn:extensionElements><zeebe:userTask /><zeebe:assignmentDefinition candidateGroups="onboarding-operations" /><zeebe:formDefinition formId="Form_Review" bindingType="deployment" /></bpmn:extensionElements></bpmn:userTask><bpmn:exclusiveGateway id="Decision" name="Approved?" default="Flow_8" /><bpmn:userTask id="Provision" name="Provision tenant, domain and DNS"><bpmn:extensionElements><zeebe:userTask /><zeebe:assignmentDefinition candidateGroups="onboarding-operations" /><zeebe:formDefinition formId="Form_Provision" bindingType="deployment" /></bpmn:extensionElements></bpmn:userTask><bpmn:userTask id="Identity" name="Configure Okta app and admin"><bpmn:extensionElements><zeebe:userTask /><zeebe:assignmentDefinition candidateGroups="onboarding-operations" /><zeebe:formDefinition formId="Form_Identity" bindingType="deployment" /></bpmn:extensionElements></bpmn:userTask><bpmn:userTask id="Access" name="Verify sign-in and tenant access"><bpmn:extensionElements><zeebe:userTask /><zeebe:assignmentDefinition candidateGroups="onboarding-operations" /><zeebe:formDefinition formId="Form_Access" bindingType="deployment" /></bpmn:extensionElements></bpmn:userTask><bpmn:userTask id="Notify" name="Send onboarding notification"><bpmn:extensionElements><zeebe:userTask /><zeebe:assignmentDefinition candidateGroups="onboarding-operations" /><zeebe:formDefinition formId="Form_Notify" bindingType="deployment" /></bpmn:extensionElements></bpmn:userTask><bpmn:userTask id="Activate" name="Activate customer workspace"><bpmn:extensionElements><zeebe:userTask /><zeebe:assignmentDefinition candidateGroups="onboarding-operations" /><zeebe:formDefinition formId="Form_Activate" bindingType="deployment" /></bpmn:extensionElements></bpmn:userTask><bpmn:endEvent id="End" name="Customer active" /><bpmn:endEvent id="Rejected" name="Registration rejected" /><bpmn:sequenceFlow id="Flow_0" sourceRef="Start" targetRef="Review" /><bpmn:sequenceFlow id="Flow_1" sourceRef="Review" targetRef="Decision" /><bpmn:sequenceFlow id="Flow_2" sourceRef="Decision" targetRef="ProvisionSystem"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= onboardingApproved = true</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_3" sourceRef="Provision" targetRef="Identity" /><bpmn:sequenceFlow id="Flow_4" sourceRef="Identity" targetRef="Access" /><bpmn:sequenceFlow id="Flow_5" sourceRef="Access" targetRef="NotificationSystem" /><bpmn:sequenceFlow id="Flow_6" sourceRef="Notify" targetRef="Activate" /><bpmn:sequenceFlow id="Flow_7" sourceRef="Activate" targetRef="End" /><bpmn:sequenceFlow id="Flow_8" sourceRef="Decision" targetRef="Rejected" /><bpmn:serviceTask id="ProvisionSystem" name="Create domain entry"><bpmn:extensionElements><zeebe:taskDefinition type="onboarding.provision-domain" retries="3" /></bpmn:extensionElements></bpmn:serviceTask><bpmn:sequenceFlow id="ProvisionSystem_success" sourceRef="ProvisionSystem" targetRef="Provision" /><bpmn:boundaryEvent id="ProvisionSystem_error" attachedToRef="ProvisionSystem"><bpmn:errorEventDefinition /></bpmn:boundaryEvent><bpmn:sequenceFlow id="ProvisionSystem_manual" sourceRef="ProvisionSystem_error" targetRef="Provision" /><bpmn:serviceTask id="NotificationSystem" name="Send onboarding notification"><bpmn:extensionElements><zeebe:taskDefinition type="onboarding.notify" retries="3" /></bpmn:extensionElements></bpmn:serviceTask><bpmn:sequenceFlow id="NotificationSystem_success" sourceRef="NotificationSystem" targetRef="Notify" /><bpmn:boundaryEvent id="NotificationSystem_error" attachedToRef="NotificationSystem"><bpmn:errorEventDefinition /></bpmn:boundaryEvent><bpmn:sequenceFlow id="NotificationSystem_manual" sourceRef="NotificationSystem_error" targetRef="Notify" /></bpmn:process><bpmndi:BPMNDiagram id="Diagram_Onboarding"><bpmndi:BPMNPlane id="Plane_Onboarding" bpmnElement="entailink_customer_onboarding"><bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start"><dc:Bounds x="80" y="80" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Review" bpmnElement="Review"><dc:Bounds x="180" y="60" width="180" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Decision" bpmnElement="Decision"><dc:Bounds x="430" y="75" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Provision" bpmnElement="Provision"><dc:Bounds x="430" y="220" width="180" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Identity" bpmnElement="Identity"><dc:Bounds x="180" y="220" width="180" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Access" bpmnElement="Access"><dc:Bounds x="180" y="380" width="180" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Notify" bpmnElement="Notify"><dc:Bounds x="430" y="380" width="180" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Activate" bpmnElement="Activate"><dc:Bounds x="430" y="540" width="180" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_End" bpmnElement="End"><dc:Bounds x="700" y="560" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Rejected" bpmnElement="Rejected"><dc:Bounds x="700" y="80" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_ProvisionSystem" bpmnElement="ProvisionSystem"><dc:Bounds x="690" y="220" width="180" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_ProvisionSystem_error" bpmnElement="ProvisionSystem_error"><dc:Bounds x="820" y="282" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_NotificationSystem" bpmnElement="NotificationSystem"><dc:Bounds x="690" y="380" width="180" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_NotificationSystem_error" bpmnElement="NotificationSystem_error"><dc:Bounds x="820" y="442" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Edge_Flow_0" bpmnElement="Flow_0"><di:waypoint x="116.0" y="98.0" /><di:waypoint x="180.0" y="100.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1"><di:waypoint x="360.0" y="100.0" /><di:waypoint x="430.0" y="100.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2"><di:waypoint x="480.0" y="100.0" /><di:waypoint x="690.0" y="260.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3"><di:waypoint x="430.0" y="260.0" /><di:waypoint x="360.0" y="260.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4"><di:waypoint x="270.0" y="300.0" /><di:waypoint x="270.0" y="380.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5"><di:waypoint x="360.0" y="420.0" /><di:waypoint x="690.0" y="420.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_Flow_6" bpmnElement="Flow_6"><di:waypoint x="520.0" y="460.0" /><di:waypoint x="520.0" y="540.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_Flow_7" bpmnElement="Flow_7"><di:waypoint x="610.0" y="580.0" /><di:waypoint x="700.0" y="578.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_Flow_8" bpmnElement="Flow_8"><di:waypoint x="480.0" y="100.0" /><di:waypoint x="700.0" y="98.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_ProvisionSystem_success" bpmnElement="ProvisionSystem_success"><di:waypoint x="690.0" y="260.0" /><di:waypoint x="610.0" y="260.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_ProvisionSystem_manual" bpmnElement="ProvisionSystem_manual"><di:waypoint x="820.0" y="300.0" /><di:waypoint x="610.0" y="260.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_NotificationSystem_success" bpmnElement="NotificationSystem_success"><di:waypoint x="690.0" y="420.0" /><di:waypoint x="610.0" y="420.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_NotificationSystem_manual" bpmnElement="NotificationSystem_manual"><di:waypoint x="820.0" y="460.0" /><di:waypoint x="610.0" y="420.0" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>